# ============================================================
# ENVIRONMENT VARIABLES — Copy this file to .env and fill in
# ============================================================

# MongoDB connection string
# Get a free cluster at: https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb://localhost:27017/ransomware_game

# Port the server will run on
PORT=5000

# Custom game mode flag (e.g. "training", "competition", "open")
GAME_MODE=training
